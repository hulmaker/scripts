#!/bin/bash

# Find all the files that have been modified in the current branch. Filter by extension.
# 
# Usage: modified_files [--extension ext] [--branch branch_name]
# 
# Examples:
#     # default settings returns all modified files with (origin/main) branch
#     >>> modified_files
# 
#     # get all .txt files that differ from files in the remote dev branch
#     >>> modified_files --extension .txt --branch origin/dev
# 
# 
# Note: This does not return untracked files, you need to add them first.
# This is basically a complicated one-liner, do not worry about it too much.

# Default values
extension=""
branch="main"

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --extension)
            extension="$2"
            shift 2
            ;;
        --branch)
            branch="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1"
            echo "Usage: $0 [--extension ext] [--branch branch_name]"
            exit 1
            ;;
    esac
done


# 1. Find the common ancestor between the target branch and the current HEAD
# This isolates your branch's unique commits from upstream changes
if ! merge_base=$(git merge-base "$branch" HEAD 2>/dev/null); then
    echo "Error: Could not find common ancestor. Check if branch '$branch' exists locally."
    exit 1
fi

# 2. Get all files modified since the fork point, excluding deleted files
extension=$(echo "$extension" | sed 's/\./\\./g')

# This only works for staged/unstaged tracked changes. 
# If the file was renamed (R), the existing file is in the third column.
files=$(
    git diff --name-status "$merge_base" |
    awk '$1 != "D" { if ($1 ~ /^R/) print $3; else print $2 }' |
    grep ".*$extension$" | tr '\n' ' '
)

echo "$files"
